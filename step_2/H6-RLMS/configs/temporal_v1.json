{
  "scope": "RLMS retrospective temporal transfer, one-year employment endpoint",
  "train_target_year_max": 2014,
  "person_hash_salt": "H6-v1:",
  "train_buckets": [0, 1, 2, 3, 4, 5],
  "evaluation_buckets": [6, 7, 8, 9],
  "temporal_pairs": [[2016, 2018], [2018, 2021], [2021, 2024]],
  "age_lower_inclusive": 18,
  "age_upper_exclusive": 65,
  "candidate_models": ["baseline", "logistic", "hgb"],
  "global_epsilon": 0.0025,
  "domain_oof_group_folds": 5,
  "density_ratio_clip": [0.2, 5.0],
  "weak_overlap_ess_fraction": 0.25,
  "t2_eta_grid": [0, 0.25, 0.5, 1],
  "t3_joint_tv_rho_grid": [0, 0.01, 0.03, 0.1],
  "t4_query_budgets": [25, 50, 100, 200],
  "labels_future_available_only_to_evaluator_or_paid_oracle": true,
  "new_independent_replication": false,
  "t4_primary_active_policy": "H2 Q2, selected in H2 for unit query costs",
  "t4_additional_active_policy": "H2 Q1, full-RLMS comparator",
  "t4_repetitions": 100,
  "t4_scenarios": ["complete_response", "MAR", "MNAR"],
  "t4_alpha_family": 0.05,
  "t4_uniform_nonresponse_rule": "bound unresolved sampled outcomes over 0/1; do not drop failed responses",
  "query_cost_success": 1,
  "query_cost_failure": 1
}
